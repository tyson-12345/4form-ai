# ── API Server ────────────────────────────────────────────────────────────────
# Point this at your running api-server.
# Local dev (same machine):
EXPO_PUBLIC_API_URL=http://localhost:3000
# If testing on a physical phone (replace with your Mac's local IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.x:3000
# Production (your deployed server URL):
# EXPO_PUBLIC_API_URL=https://api.yourapp.com

# ── Google Sign-In ────────────────────────────────────────────────────────────
# Client IDs from Google Cloud Console → APIs & Services → Credentials. These
# are public identifiers, not secrets — they travel in the authorization URL of
# every sign-in — so committing them is fine.
#
# The "Continue with Google" button is hidden on any platform whose ID is unset,
# so leaving these blank disables the feature cleanly rather than showing a
# button that fails after the user has been through Google's consent screen.
#
# Sign in with Apple needs nothing here: it is configured by the capability on
# the App ID and the `usesAppleSignIn` flag in app.json.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
