{
  "expo": {
    "name": "AthleteAI",
    "slug": "athleteai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athleteai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101312"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.athleteai.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "AthleteAI reads the training video you pick so it can measure your joint angles frame by frame on this device, and the photo you pick if you set a profile picture. Neither ever leaves your phone \u2014 only the resulting angle measurements are sent, never the footage or the photo."
      }
    },
    "android": {
      "package": "com.athleteai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#101312"
      },
      "permissions": [
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "AthleteAI reads the training video you pick so it can measure your joint angles frame by frame on this device, and the photo you pick if you set a profile picture. Neither ever leaves your phone \u2014 only the resulting angle measurements are sent, never the footage or the photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
