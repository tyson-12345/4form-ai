# 4Form AI API — environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every value here is a secret or a security control; see docs/SECURITY.md.
#
# Required to boot:  DATABASE_URL, JWT_SECRET, PORT
# Required in prod:  the above + ANTHROPIC_API_KEY, ALLOWED_ORIGINS, TRUST_PROXY

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
#
# Use the SESSION POOLER (port 5432 on pooler.supabase.com), not the transaction
# pooler on 6543: this API is a long-running process with a connection pool, and
# transaction mode is PgBouncer without prepared statements or session state.
# Full walkthrough: docs/SUPABASE-MIGRATION.md
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional. Set only if TLS fails with "self-signed certificate in certificate
# chain". Download from Project Settings → Database → SSL Configuration and
# paste the PEM here.
#
# Do NOT "fix" that error by disabling certificate verification — that keeps the
# encryption and discards the authentication, which is the part that stops a
# man-in-the-middle.
DATABASE_CA_CERT=

# Max concurrent connections in the pool. Raise only alongside the database's
# own connection limit.
DATABASE_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters — the server refuses to start below that.
# Generate:  openssl rand -base64 48
# Rotating this invalidates every existing session, which is the point after a
# suspected leak.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ── Federated sign-in (Apple, Google) ─────────────────────────────────────────
# Comma-separated lists of accepted `aud` values. A provider's button is hidden
# in the app until its list is set, and the server refuses to verify a token for
# an unconfigured provider rather than accepting any audience.
#
# **This is not an optional hardening step.** Google issues valid, correctly
# signed ID tokens for the same user to every app that asks. Without an audience
# allowlist, a token that any other Google-integrated app was handed would be
# accepted here as that user. The server therefore throws instead of defaulting.
#
# APPLE_CLIENT_IDS — the iOS bundle identifier for native sign-in
#   (com.fourformai.app), plus the Services ID if you add web sign-in.
#   Apple Developer → Certificates, Identifiers & Profiles → Identifiers,
#   with the "Sign in with Apple" capability enabled on the App ID.
APPLE_CLIENT_IDS=

# GOOGLE_CLIENT_IDS — every OAuth client ID that can produce a token for this
#   app: the iOS client, the Android client, and the Web client.
#   Google Cloud Console → APIs & Services → Credentials.
#   All three go here; the token's `aud` is whichever client minted it.
GOOGLE_CLIENT_IDS=

# ── AI (Claude) ───────────────────────────────────────────────────────────────
# https://console.anthropic.com → API keys.
# Optional locally: without it, clips are still measured and scored, but there
# are no written coaching notes and no chat. Required in production.
ANTHROPIC_API_KEY=sk-ant-...

# ── Transactional email ───────────────────────────────────────────────────────
# Password reset and account-lockout notices. Without a provider the app still
# runs, but a user who forgets their password is permanently locked out.
#
# Verify a change here with:  pnpm mail:verify you@example.com
# That sends one real message through the same code path the app uses and names
# what is wrong if it fails — every misconfiguration below otherwise presents as
# the identical symptom, "the email never arrived".
#
# Set MAIL_FROM plus exactly ONE provider credential. Full setup, including the
# SPF/DKIM/DMARC records you must publish, is in docs/EMAIL-SETUP.md.
#
# Must be on a domain you have authenticated with the provider:
MAIL_FROM=4Form AI <no-reply@mail.4formai.com>

# Option 1 — Resend (https://resend.com)
RESEND_API_KEY=

# Option 2 — Postmark (https://postmarkapp.com)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# Option 3 — Amazon SES
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Base URL used to build reset links. Must match where the app actually serves
# the reset screen, or every reset link 404s.
APP_PUBLIC_URL=https://4formai.com

# ── Billing (RevenueCat) ──────────────────────────────────────────────────────
# Both must be set before the app shows a working purchase button. While unset,
# purchase verification returns 501 rather than granting a tier for free.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API. Native apps send no
# Origin header and are unaffected. Leave unset locally to use the Expo defaults.
ALLOWED_ORIGINS=

# Number of proxies in front of the server (Railway/Render/Fly/nginx = 1).
# NOT OPTIONAL behind a load balancer: without it every request appears to come
# from the proxy IP, so per-IP rate limits collapse into one global limit.
# Leave unset when the server is directly exposed.
TRUST_PROXY=

# ── Error reporting ───────────────────────────────────────────────────────────
# Sentry. Everything is a no-op while this is unset, so the integration ships
# dormant and costs nothing until you create a project.
#
# Request bodies, cookies, query strings, and any key matching
# password/token/secret/authorization/cookie/api-key/email are stripped before
# an event leaves the process — see lib/observability.ts.
SENTRY_DSN=

# Fraction of requests traced for performance. Errors are always captured.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Optional ──────────────────────────────────────────────────────────────────
# Shared rate-limit counters. Required before running more than one instance —
# without it each instance enforces its own limit and the effective limit is
# multiplied by the instance count.
REDIS_URL=

LOG_LEVEL=info

# Development escape hatches. Both are ignored when NODE_ENV=production.
# Never set either in a deployed environment.
CORS_ALLOW_ALL=
ALLOW_DEV_TIER_OVERRIDE=
